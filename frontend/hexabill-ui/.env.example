# API base URL (used by apiConfig.js). No trailing slash; /api is appended if missing.
# - Not set + app opened from localhost → uses http://localhost:5000/api (backend must be running).
# - Not set + app opened from production (e.g. Vercel) → uses https://hexabill.onrender.com/api.
# - For Vercel: set in Project Settings -> Environment Variables.
#   VITE_BASE_DOMAIN=hexabill.company
#   VITE_PLATFORM_HOST=admin.hexabill.company
#   VITE_API_BASE_URL=https://api.hexabill.company/api
# - For local dev: http://localhost:5000 or http://localhost:5000/api
VITE_API_BASE_URL=http://localhost:5000/api

# --- AI provider keys do NOT belong here ---
# Anything named VITE_* is copied into the public browser bundle, so a key here would be readable by every visitor.
# The frontend reads no AI key. Provider keys are set on the backend server (Render > Environment) as Ai__Providers__<name>__ApiKey.
# See docs/plan/AI-GATEWAY-CONFIG.md.
# --- POS Enterprise V2 (ON by default) ---
# Opt out: VITE_POS_ENTERPRISE_V2=false  OR  localStorage.hexabill_pos_enterprise_v2=0
# VITE_POS_ENTERPRISE_V2=true
